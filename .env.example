# =============================================================================
# Server
# =============================================================================
WEB_LISTEN=:8080
LOG_LEVEL=info          # debug, info, warn, error
LOG_FORMAT=text         # text, json

# =============================================================================
# Authentication
# =============================================================================
JWT_SECRET_KEY=
# JWT_SECRET_KEY_FILE=/run/secrets/jwt_secret_key

# Dev only: all anonymous sessions resolve to one fixed local user.
# DEV_SINGLE_USER=true

# =============================================================================
# Discord OAuth (create app at https://discord.com/developers/applications)
# =============================================================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
# DISCORD_REDIRECT_URI=      # optional override, frontend constructs default

# =============================================================================
# Spotify OAuth (create app at https://developer.spotify.com/dashboard)
# =============================================================================
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_CLIENT_SECRET_FILE=/run/secrets/spotify_client_secret
# SPOTIFY_REDIRECT_URI is REQUIRED - the Spotify feature stays disabled unless
# all three of client id, client secret and redirect URI are set.
# The redirect URI must match an entry in the Spotify app dashboard EXACTLY
# (scheme, host, port and path - no trailing slash differences).
# Spotify rejects "http://localhost": in dev use the loopback IP instead and
# open the app at 127.0.0.1:5173 so the browser origin matches. Production
# redirect URIs must be HTTPS.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/spotify/callback

# =============================================================================
# Rate Limiting (requests per minute)
# =============================================================================
# Token bag players are unauthenticated, so they are limited per IP: a venue
# running several rooms behind one NAT may need to raise RATE_LIMIT_ANON.
# RATE_LIMIT_ANON=120
# RATE_LIMIT_AUTH=120

# =============================================================================
# Anonymous User Cleanup
# =============================================================================
# ANONYMOUS_MAX_AGE=8760h    # 365 days

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clockkeeper
DB_USER=postgres
DB_PASSWORD=postgres
# DB_PASSWORD_FILE=/run/secrets/db_password
